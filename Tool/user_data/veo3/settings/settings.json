    "token_retrieval_timeout_seconds": 60,
    "load_cookie_profile": true,
    "user_agent_mode": "request",
    "static_user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36",
    "apply_user_agent_override": false,
    "apply_hide_window_script": false,
    "window_far_position": true,
    "use_window_size": true,
