  "network": {
    "request_timeout_seconds": 300,
    "proxy_string": "",
    "apply_request_proxy": true,
    "chrome_version": "chrome146",
    "request_user_agent_mode": "custom",
    "request_user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36",
    "adapt_request_user_agent_to_os": true,
    "complete_adapt_request_user_agent_to_os": true,
    "use_request_user_agent": true,
